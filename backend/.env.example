# Copy to .env (git-ignored) and fill in from Supabase:
#   Project Settings -> Database -> Connection string -> Session pooler
#
# Never commit the real password.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.iwtktpdjebrngqotauny
SUPABASE_DB_PASSWORD=

# The credential the ML service presents to /internal/**. Any long random
# string; generate one rather than choosing it, e.g.
#   openssl rand -base64 32
# The same pair goes in ml-service/.env so training can fetch its data.
INTERNAL_API_USER=ml-service
INTERNAL_API_PASSWORD=
